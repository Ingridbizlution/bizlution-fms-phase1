  "query": "\n        SELECT m.meter_code::text AS \"meter_code!\",\n               m.name::text       AS \"name!\",\n               m.unit::text       AS \"unit!\",\n               m.last_value::float8 AS \"last_value\",\n               m.last_read_at\n        FROM fms.asset_meters m\n        WHERE m.asset_id = $1 AND m.is_active\n        ORDER BY m.meter_code\n        ",
