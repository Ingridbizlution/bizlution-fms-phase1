  "query": "\n        SELECT m.id,\n               m.meter_code::text AS \"meter_code!\",\n               m.reading_type,\n               m.last_value::float8   AS \"last_value\",\n               m.last_read_at,\n               m.rollover_at::float8  AS \"rollover_at\"\n        FROM fms.asset_meters m\n        WHERE m.asset_id = $1 AND lower(m.meter_code) = lower($2) AND m.is_active\n        ",
