# =============================================================================
# Facility Management System 正式環境 — 環境變數範本
# =============================================================================
# 使用方式： cp .env.prod.example .env   然後把每一個 change_me_* 換成真的值
# （建議用 openssl rand -hex 32 之類的工具產生，不要手打）。
#
# 這份 .env 只存在於 VM 上，**絕不進版控**，也不會被 CI/CD 上傳——deploy
# 流程只會 `git pull` 程式碼，不會動這個檔案。
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres
POSTGRES_DB=fms
FMS_OWNER_PASSWORD=change_me_owner
FMS_APP_PASSWORD=change_me_app
FMS_READONLY_PASSWORD=change_me_readonly
FMS_BACKUP_PASSWORD=change_me_backup
TZ=Asia/Taipei

# ---- MinIO（S3 相容儲存體）----
MINIO_ROOT_USER=fmsminio
MINIO_ROOT_PASSWORD=change_me_minio

# =============================================================================
# fms-server / fms-jobs 共用（見 docker/README.md「API server 的環境變數」
# 一節，五個必填變數缺任何一個服務都起不來）
# =============================================================================

# fms-server／fms-jobs 都用 fms_app 連線（RLS 才會生效）；
# host 是 compose 的 service name，不是 localhost。
APP_DATABASE_URL=postgresql://fms_app:change_me_app@postgres:5432/fms
# fms-jobs 的跨租戶批次工作需要 fms_owner（見各 worker 的 SECURITY DEFINER
# context 切換說明）。
OWNER_DATABASE_URL=postgresql://fms_owner:change_me_owner@postgres:5432/fms

# 至少 32 字元，過短直接啟動失敗。
JWT_SECRET=change_me_at_least_32_characters_long

# S3_ENDPOINT 由 docker-compose.prod.yml 直接注入（http://minio:9000），
# 這裡只需要金鑰。
S3_ACCESS_KEY=fmsminio
S3_SECRET_KEY=change_me_minio

# 前端會從哪些來源打這支 API——逗號分隔，不支援 `*`（見
# docker/README.md 的 CORS 章節說明為什麼）。
CORS_ALLOWED_ORIGINS=https://fms.bizlution.ai

# /auth/sso/* 的 redirect_uri 由它組出；這裡要填正式對外的網域。
#
# 同一個值也被 docker-compose.prod.yml 拿去組 S3_PUBLIC_ENDPOINT
# （`${PUBLIC_BASE_URL}/storage`）——BIM 模型／附件的預簽網址要換成
# 這個公開位址才能讓瀏覽器直傳，MinIO 本身刻意不對外開 port（見
# docker-compose.prod.yml 的 `minio` service 註解）。**因此機房那層
# nginx／反向代理必須加一條 `/storage/` 的路由轉到 127.0.0.1:9000，
# 並把轉發的 `Host` 標頭原樣設回 `minio:9000`**（見
# docker/README.md「MinIO 預簽網址的反向代理」一節）——這步是手動的，
# 不在 CI/CD 的自動部署腳本裡。
PUBLIC_BASE_URL=https://api.fms.bizlution.ai

# =============================================================================
# fms-jobs 專用——**PM_GENERATOR_USER_ID 與 DIRECTORY_SYNC_USER_ID 是必填**，
# 缺任何一個 fms-jobs 整支程式會直接退出（`main.rs` 用 `?` 提前失敗，不是
# 「這個迴圈不啟動、其他照跑」）。這點跟其餘幾個 worker 變數不一樣，
# 本機用 `docker compose -f docker-compose.prod.yml up` 實測驗證過。
#
# 兩者都要指向**真實租戶**、已建立 TENANT 範圍角色指派的服務帳號 id
# （見 migration 019／078）——**在還沒有真實客戶租戶之前，沒有合法的值
# 可填，fms-jobs 這個服務先不要啟動**（`docker compose up -d` 時明確列出
# 要啟動的服務名稱，不要用不帶服務名稱的 `up -d`，避免 fms-jobs 卡在
# crash-loop）：
#
#   docker compose -f docker-compose.prod.yml up -d postgres minio minio-init mosquitto fms-server caddy
#
# 等第一個真實租戶建立、對應的服務帳號也建好之後，把下面兩個變數填上，
# 再 `docker compose -f docker-compose.prod.yml up -d fms-jobs`。
PM_GENERATOR_USER_ID=
DIRECTORY_SYNC_USER_ID=

# 其餘幾個才是真的選用——沒設就只是那個功能不啟動，fms-jobs 其他部分正常跑。
# CALENDAR_SYNC_USER_ID=
# MS365_APP_CLIENT_ID=
# MS365_APP_CLIENT_SECRET=

# ---- bim-worker 專用（獨立的 Python 服務，見 services/bim-worker/） ----
# 跟 PM_GENERATOR_USER_ID／DIRECTORY_SYNC_USER_ID 同一個道理，但這是
# bim-worker 自己的變數，不是 fms-jobs 的——缺了會讓整支程式直接退出
# （`os.environ["BIM_INGEST_WORKER_USER_ID"]`，見 main.py），要指向真實
# 租戶已建立 TENANT 範圍角色指派的服務帳號（見 migration 080）。示範租戶
# 已經建好：f5000000-0000-4000-8000-000000000003。填好之後用
# `docker compose -f docker-compose.prod.yml --profile with-bim-worker up -d`
# 啟動這個服務。
BIM_INGEST_WORKER_USER_ID=

# IdP 密鑰（SSO／LDAP 用），命名規則見 docker/README.md：
# 參照 okta/prod/client-secret → IDP_SECRET_OKTA_PROD_CLIENT_SECRET
# IDP_SECRET_...=
