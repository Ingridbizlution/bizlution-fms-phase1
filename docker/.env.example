# =============================================================================
# Facility Management System 本機開發環境 — 環境變數範例
# =============================================================================
# 使用方式： cp .env.example .env  然後依需要調整
# .env 已在 .gitignore 中；請勿把真實密碼提交進版控。
# =============================================================================

# ---- PostgreSQL ----
# 超級使用者僅用於容器初始化，應用與 migration 都不使用它
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres
POSTGRES_DB=fms
# 對外埠號刻意避開 5432，避免與開發者本機既有的 PostgreSQL 衝突
POSTGRES_PORT=5433

# 三個應用角色的密碼（開發用，正式環境改由密鑰管理服務注入）
FMS_OWNER_PASSWORD=change_me_owner
FMS_APP_PASSWORD=change_me_app
FMS_READONLY_PASSWORD=change_me_readonly
# 備份專用角色（BYPASSRLS、唯讀）—— pg_dump 用它，還原不用
FMS_BACKUP_PASSWORD=change_me_backup

TZ=Asia/Taipei

# ---- Redis ----
REDIS_PORT=6380

# ---- MinIO（S3 相容儲存體）----
MINIO_ROOT_USER=fmsminio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Mailpit（攔截外寄信件）----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Adminer（docker compose --profile tools up）----
ADMINER_PORT=8080

# ---- MQTT（docker compose --profile iot up）----
MQTT_PORT=1883
MQTT_WS_PORT=9002

# =============================================================================
# 應用服務（FastAPI）連線字串範例 — 貼到 API 專案的 .env
# =============================================================================
# 注意：API 一律以 fms_app 連線。用 fms_owner 或 postgres 連線會讓 RLS 失效。
#
# DATABASE_URL=postgresql+asyncpg://fms_app:change_me_app@localhost:5433/fms
# DATABASE_URL_MIGRATION=postgresql://fms_owner:change_me_owner@localhost:5433/fms
# DATABASE_URL_REPORTING=postgresql+asyncpg://fms_readonly:change_me_readonly@localhost:5433/fms
# REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fmsminio
S3_SECRET_KEY=change_me_minio
S3_BUCKET_ATTACHMENTS=fms
# 預簽下載網址的有效期（秒）。預設 900。
# S3_DOWNLOAD_TTL_SECONDS=900

# 背景作業（fms-jobs）：PM 產生器的寫入身分。
# 由 migration 019 建立；每個租戶都需要自己的服務帳號（見該檔說明）。
PM_GENERATOR_USER_ID=f5000000-0000-4000-8000-000000000001
# S3_BUCKET_BIM=fms-bim
# S3_BUCKET_EXPORTS=fms-exports
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MQTT_BROKER=mqtt://localhost:1883
